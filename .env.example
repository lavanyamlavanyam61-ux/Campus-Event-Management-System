# Server & Authentication
PORT=3000
JWT_SECRET="replace-with-a-secure-random-secret-in-production"
DATABASE_PATH="./data/campus_events.db"

# Public Deployment Security
# Required when a user registers an Administrator account
ADMIN_INVITE_CODE="MERIDIAN-ADMIN-2026"
# Set to "true" in public production to hide one-click demo sign-in buttons
DISABLE_DEMO_LOGIN="false"

# App URL (automatically injected in AI Studio runtime)
APP_URL="http://localhost:3000"
